<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        style="@style/titulo_seccao"
        android:text="@string/app_name"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Tarefa 1 - Shared Preferences -->
    <LinearLayout style="@style/contentor_geral">

        <View style="@style/linha_separacao" />

        <TextView
            style="@style/titulo_seccao"
            android:text="@string/shared_preferences" />

        <EditText
            android:id="@+id/editText1"
            style="@style/editText"
            android:hint="@string/sharedPrefencesEditText"
            android:inputType="text"
            android:text="" />

        <LinearLayout style="@style/contentor_horizontal">

            <Button
                android:id="@+id/btWrite1"
                style="@style/buttonWrite"
                android:text="@string/btWrite" />

            <Button
                android:id="@+id/btRead1"
                style="@style/buttonRead"
                android:text="@string/btRead" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>